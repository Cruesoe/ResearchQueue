<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsRimWorldMod>false</IsRimWorldMod>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ResearchQueueFixture</RootNamespace>
    <AssemblyName>ResearchQueueFixture</AssemblyName>
    <Nullable>enable</Nullable>
    <QueueAssembly Condition="'$(QueueAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\..\1.7\Assemblies\ResearchQueue.dll</QueueAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ResearchQueue"><HintPath>$(QueueAssembly)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldRoot)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldRoot)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(QueueAssembly)')" Text="Build Research Queue for 1.7 first or set QueueAssembly." />
    <Error Condition="!Exists('$(RimWorldRoot)\Assembly-CSharp.dll')" Text="Set RimWorldRoot to the installed 1.7 game." />
  </Target>
  <Target Name="PrepareFixture" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\1.7\Assemblies" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\1.7\Assemblies" />
  </Target>
</Project>
